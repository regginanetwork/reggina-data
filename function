    (function(){
      var h  = document.getElementById('rnh');
      var b  = document.getElementById('rnh-burger');
      var p  = document.getElementById('rnh-panel');
      var d  = document.getElementById('rnh-drop');
      var dt = document.getElementById('rnh-drop-t');
      var mobile = window.matchMedia('(max-width: 900px)');

      /* L'header collassa scendendo e si riapre solo tornando in cima.
         Il cambio di stato accorcia la pagina e sposta lo scroll: senza
         questa soglia larga si innescherebbe un rimbalzo continuo. */
      if (h) {
        var giu = 120, su = 4, min = false, tick = false;

        function valuta() {
          var y = window.scrollY || window.pageYOffset;
          if (!min && y > giu) {
            min = true;
            h.classList.add('rnh-min');
          } else if (min && y <= su) {
            min = false;
            h.classList.remove('rnh-min');
          }
          tick = false;
        }

        function onScroll() {
          if (tick) return;
          tick = true;
          requestAnimationFrame(valuta);
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        valuta();
      }

      function togglePanel(forza) {
        var aperto = (forza !== undefined) ? forza : !p.classList.contains('open');
        p.classList.toggle('open', aperto);
        b.setAttribute('aria-expanded', aperto ? 'true' : 'false');
      }

      if (b && p) {
        b.addEventListener('click', function(e){ e.stopPropagation(); togglePanel(); });
      }

      if (d && dt) {
        dt.addEventListener('click', function(e){
          e.stopPropagation();
          // Su mobile "RN Starter Pack" apre lo stesso pannello dell'hamburger
          if (mobile.matches) { togglePanel(); return; }
          var aperto = d.classList.toggle('open');
          dt.setAttribute('aria-expanded', aperto ? 'true' : 'false');
        });
      }

      function chiudiTutto() {
        if (d) { d.classList.remove('open'); dt.setAttribute('aria-expanded','false'); }
        if (p) { togglePanel(false); }
      }

      document.addEventListener('click', function(e){
        if (h && !h.contains(e.target)) chiudiTutto();
      });
      document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') chiudiTutto();
      });
    })();
    </script>
