/*	-----------------------------------------------------------------------------------------------
	CACHE LOCALE JSON — fallback se GitHub non risponde
--------------------------------------------------------------------------------------------------- */

function rn_get_json( $chiave, $file ) {
    $transient_key = 'rn_json_' . $chiave;
    $backup_key    = 'rn_json_backup_' . $chiave;
    $url           = RN_GITHUB_BASE . $file . '?t=' . time();

    $response = wp_remote_get( $url, [ 'timeout' => 8 ] );

    if ( ! is_wp_error( $response ) && wp_remote_retrieve_response_code( $response ) === 200 ) {
        $body = wp_remote_retrieve_body( $response );
        $data = json_decode( $body, true );
        if ( is_array( $data ) ) {
            set_transient( $transient_key, $body, HOUR_IN_SECONDS );
            update_option( $backup_key, $body ); // backup permanente
            return $body;
        }
    }

    // GitHub non risponde: prova la cache oraria
    $cached = get_transient( $transient_key );
    if ( $cached ) return $cached;

    // Ultima spiaggia: il backup permanente
    $backup = get_option( $backup_key, null );
    if ( $backup ) return $backup;

    return null;
}
function rn_register_api_routes() {
    $endpoints = [
        'calendario'  => 'calendario.json',
        'classifica'  => 'classifica.json',
        'rosa'        => 'rosa-anagrafica.json',
        'minuti-gol'  => 'minuti-gol.json',
    ];

    foreach ( $endpoints as $chiave => $file ) {
        register_rest_route( 'rn/v1', '/data/' . $chiave, [
            'methods'             => 'GET',
            'callback'            => function() use ( $chiave, $file ) {
                $body = rn_get_json( $chiave, $file );
                if ( $body === null ) {
                    return new WP_Error( 'no_data', 'Dati non disponibili', [ 'status' => 503 ] );
                }
                $response = new WP_REST_Response( json_decode( $body, true ) );
                $response->header( 'Cache-Control', 'public, max-age=300' );
                return $response;
            },
            'permission_callback' => '__return_true',
        ] );
    }
}
add_action( 'rest_api_init', 'rn_register_api_routes' );

