      window.rrSvuota=function(){ scelti={}; disegna(); };

      /* Mostriamo l'anno a ogni under in campo, non solo ai tre che
         coprono le quote: chi guarda vuole vedere tutti i giovani. */
      function annoUnder(g){
        if (!g || !g.a) return null;
        return g.a>=2006 ? g.a : null;
      }

      function disegna(){
        var p=document.getElementById('rr-pitch');
        p.querySelectorAll('.rr-slot').forEach(function(s){s.remove()});

        MODULI[modulo].forEach(function(pos,i){
          var g=scelti[i];
          var d=document.createElement('div');
          d.className='rr-slot '+(g?'full':'empty');
          d.style.left=pos[0]+'%'; d.style.top=pos[1]+'%';
