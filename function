        if(m>=70)return '#A83232';
        if(m>=45)return '#C46A6A';
        if(m>=20)return '#DDA3A3';
        return '#EDD0D0';
      }
      function colVoto(v){
        if(v>=7)return '#1a7a3a';
        if(v>=6.5)return '#5BA35B';
        if(v>=6)return '#9DBF6A';
        if(v>=5.5)return '#E8A33D';
        return '#C0392B';
      }

      /* ---------- MINUTAGGI ---------- */
      function renderMin(){
        if(!allP.length||!matches.length){
          document.getElementById('rnd-vmin').innerHTML='<div class="rnd-empty"><div class="rnd-empty-t">Nessun dato disponibile</div><div class="rnd-empty-b">I minutaggi compariranno dopo la prima partita.</div></div>';
          return;
        }

        const sorted=[...allP].sort((a,b)=>{
          const ma=Object.values(a.giornate).reduce((s,g)=>s+g.min,0);
