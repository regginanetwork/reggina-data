          '<div class="rr-q-row">'+
          r.map(function(x){
            return '<div class="rr-q-i'+(x.g?' on':'')+'">'+
              '<span class="rr-q-y">'+x.q.l+'</span>'+
              '<span class="rr-q-n">'+(x.g?x.g.c:'da inserire')+'</span></div>';
          }).join('')+'</div>';
      }

