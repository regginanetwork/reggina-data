      /* ---------- QUOTE UNDER ----------
         Servono tre giocatori distinti: uno nato nel 2008 o dopo, uno nel 2007
         o dopo, uno nel 2006 o dopo. Partiamo dalla quota più stretta e su
         ciascuna prendiamo il più vecchio fra gli idonei, così i più giovani
         restano liberi per le quote successive. */
      function calcolaQuote(){
        var quote=[{y:2008,l:'2008 o under'},{y:2007,l:'2007 o under'},{y:2006,l:'2006 o under'}];
        var disp=Object.keys(scelti).map(function(k){return scelti[k]});
        var res=[];
        quote.forEach(function(q){
          var cand=disp.filter(function(g){ return g.a ? g.a>=q.y : false; })
                       .sort(function(a,b){ return a.a-b.a; });
          var s=cand.length?cand[0]:null;
          if(s) disp.splice(disp.indexOf(s),1);
          res.push({q:q,g:s});
        });
        return res;
      }

      function renderQuote(){
        var r=calcolaQuote();
        var ok=r.every(function(x){return x.g});
        document.getElementById('rr-quote').innerHTML=
          '<div class="rr-q-top"><span class="rr-q-t">Quote under</span>'+
