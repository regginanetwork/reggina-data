// Cerca i loghi nella libreria media per nome file
function rn_get_logo_url( $team_name ) {
    global $wpdb;

    // Nomi file che non corrispondono al nome della squadra
    $alias = [
        'castrumfavara'      => 'C.-Favara',
        'nuova igea virtus'  => 'N.-Igea-Virtus',
        // aggiungi qui altre eccezioni: 'nome squadra' => 'Nome-File'
    ];

    $key = mb_strtolower( trim( $team_name ) );

    if ( isset( $alias[ $key ] ) ) {
        $candidati = [ $alias[ $key ] ];
    } else {
        $candidati = [ implode( '-', array_map( function($w) {
            return mb_strtoupper( mb_substr($w, 0, 1) ) . mb_strtolower( mb_substr($w, 1) );
        }, preg_split( '/\s+/', trim( $team_name ) ) ) ) ];
    }

    foreach ( $candidati as $filename ) {
        foreach ( ['png', 'jpg', 'jpeg', 'webp'] as $ext ) {
            // LIKE è case-insensitive: trova anche PraiaTortora.jpg da Praiatortora
            $result = $wpdb->get_var( $wpdb->prepare(
                "SELECT ID FROM {$wpdb->posts}
                 WHERE post_type = 'attachment' AND post_status = 'inherit'
                 AND guid LIKE %s LIMIT 1",
                '%/' . $filename . '.' . $ext
            ) );
            if ( $result ) return wp_get_attachment_url( $result );
        }
    }
    return '';
}

function reggina_calendario_script() {
    if ( ! is_page( 'calendario' ) ) return;

    // Costruisce la lista dei loghi per tutte le squadre nel calendario
    $json_url = RN_GITHUB_BASE . 'calendario.json';
    $response = wp_remote_get( $json_url, ['timeout' => 10] );
    $loghi = [];

    if ( ! is_wp_error( $response ) ) {
        $rows = json_decode( wp_remote_retrieve_body( $response ), true );
        if ( is_array( $rows ) ) {
            $squadre = array_unique( array_filter( array_column( $rows, 'avversario' ) ) );
            $squadre[] = 'Reggina';
            foreach ( $squadre as $squadra ) {
                $url = rn_get_logo_url( $squadra );
                if ( $url ) $loghi[ $squadra ] = $url;
            }
        }
    }

    $loghi_json = json_encode( $loghi );
    ?>
