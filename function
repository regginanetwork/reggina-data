	$bjork_block_pattern_categories = apply_filters( 'bjork_block_pattern_categories', array(
		'bjork-blog'    => array('label' => esc_html__( 'Björk Blog', 'bjork' )),
		'bjork-cta'     => array('label' => esc_html__( 'Björk Call to Action', 'bjork' )),
		'bjork-general' => array('label' => esc_html__( 'Björk General', 'bjork' )),
	) );
	uasort( $bjork_block_pattern_categories, function( $a, $b ) { return strcmp( $a["label"], $b["label"] ); });
	foreach ( $bjork_block_pattern_categories as $slug => $settings ) {
		register_block_pattern_category( $slug, $settings );
	}
}
