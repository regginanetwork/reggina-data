      /* La data arriva come 04/01/2002: prendiamo l'ultimo gruppo di 4 cifre,
         così funziona anche se il giorno o il mese fossero a quattro cifre. */
      function anno(d){
        var m=String(d||'').match(/(\d{4})(?!.*\d{4})/);
        return m?parseInt(m[1],10):0;
      }

     fetch(BASE+'rosa?t='+Date.now())
        .then(function(r){ if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); })
        .then(function(rows){
          ROSA=rows.filter(function(r){
            var v=String(r['in rosa']||'').toLowerCase();
            if (v!=='sì') {
              if (v!=='si') return false;
            }
            return String(r['cognome']||'').trim()!=='';
          }).map(function(r){
            return {
              m:String(r['numero maglia']||'').trim(),
              n:String(r['nome']||'').trim(),
              c:String(r['cognome']||'').trim(),
              r:String(r['ruolo']||'').toLowerCase().trim(),
              uo:String(r['under/over']||'').trim(),
              nascita:String(r['data di nascita']||'').trim(),
              contratto:String(r['tipologia contratto']||'').trim(),
              scadenza:String(r['scadenza contratto']||'').trim(),
              tm:String(r['transfermarkt']||'').trim(),
              a:anno(r['data di nascita'])
            };
          }).sort(function(a,b){
            var d=RO.indexOf(a.r)-RO.indexOf(b.r);
            return d!==0?d:(parseInt(a.m)||99)-(parseInt(b.m)||99);
          });
          // L'indice è l'identificatore univoco: cognomi e numeri di maglia
          // possono ripetersi o mancare
          ROSA.forEach(function(g,i){ g.id=i; });
          renderRosa(); initModuli(); disegna();
