function reggina_classifica_shortcode() {

    // Loghi dalla libreria media, stessa logica del calendario
    $loghi = [];
    $response = wp_remote_get( RN_GITHUB_BASE . 'classifica.json', ['timeout' => 10] );
    if ( ! is_wp_error( $response ) ) {
        $rows = json_decode( wp_remote_retrieve_body( $response ), true );
        if ( is_array( $rows ) ) {
            foreach ( $rows as $r ) {
                $sq = isset( $r['squadra'] ) ? trim( $r['squadra'] ) : '';
                if ( ! $sq ) continue;
                $url = rn_get_logo_url( $sq );
                if ( $url ) $loghi[ $sq ] = $url;
            }
        }
    }
    $loghi_json = wp_json_encode( $loghi );

    ob_start();
    ?>
