    <script>
    (function(){
     var URL_JSON = '<?php echo rest_url('rn/v1/data/classifica'); ?>';
      var LOGHI = <?php echo $loghi_json; ?>;

      function n(v){ var x = parseInt(String(v == null ? '' : v).trim(), 10); return isNaN(x) ? 0 : x; }

      // "una partita", "due partite", "tre partite"...
      function parola(k){
        var w = ['', 'una', 'due', 'tre', 'quattro', 'cinque', 'sei', 'sette', 'otto'];
        return w[k] || String(k);
      }
      function stelle(k){ var s = ''; for (var i = 0; i < k; i++) s += '*'; return s; }

      var target = document.getElementById('classifica-serie-d');

      fetch(URL_JSON + '?t=' + Date.now())
        .then(function(r){ if(!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
        .then(function(rows){

          var squadre = rows.filter(function(r){
            return String(r['squadra'] || '').trim() !== '';
          }).sort(function(a,b){
            return n(b['punti']) - n(a['punti'])
                || n(b['dr'])    - n(a['dr'])
                || n(b['gf'])    - n(a['gf'])
                || String(a['squadra']).localeCompare(String(b['squadra']));
          });

          var tot = squadre.length;

          // Il riferimento e' la squadra che ha giocato di piu':
          // chi sta sotto ha partite da recuperare.
          var maxG = 0;
          squadre.forEach(function(r){ var g = n(r['partite giocate']); if (g > maxG) maxG = g; });

          var scarti = {};        // quali scarti sono presenti in tabella
          var penalizzate = [];   // squadre con punti di penalizzazione

          var h = '<div class="c-wrap"><table><thead><tr><th>#</th><th class="text-left">Squadra</th><th>PT</th><th>G</th><th>V</th><th>N</th><th>P</th><th>DR</th></tr></thead><tbody>';

          squadre.forEach(function(r, i){
            var pos = i + 1;
            var sq = String(r['squadra'] || '').trim();
            var ev = sq.toLowerCase().indexOf('reggina') > -1 ? 'highlight-reggina' : '';

            var z = '';
            if (pos === 1) z = 'row-promo';
            else if (pos >= 2 && pos <= 5) z = 'row-playoff';
            else if (pos > tot - 2) z = 'row-retro';
            else if (pos > tot - 6) z = 'row-playout';

            var dr = n(r['dr']);
            var g  = n(r['partite giocate']);
            var pen = Math.abs(n(r['penalità']));

            var mark = '';
            var diff = maxG - g;
            if (diff > 0) { mark += stelle(diff); scarti[diff] = true; }
            if (pen > 0)  { mark += '°'; penalizzate.push({ nome: sq, pt: pen }); }

            var url = LOGHI[sq] || '';
            var logo = url
              ? '<img class="team-logo" src="' + url + '" alt="" loading="lazy">'
              : '<span class="team-logo-ph"></span>';

            h += '<tr class="' + z + '"><td class="pos-col">' + pos + '</td>'
              +  '<td class="text-left"><span class="team-cell">' + logo
              +  '<span class="team-name ' + ev + '">' + sq
              +  (mark ? '<span class="mark">' + mark + '</span>' : '')
              +  '</span></span></td>'
              +  '<td class="pts-col">' + n(r['punti']) + '</td>'
              +  '<td>' + g + '</td>'
              +  '<td>' + n(r['vittorie']) + '</td>'
              +  '<td>' + n(r['pareggi']) + '</td>'
              +  '<td>' + n(r['sconfitte']) + '</td>'
              +  '<td>' + (dr > 0 ? '+' : '') + dr + '</td></tr>';
          });

          h += '</tbody></table></div>';

          // Note sotto la tabella
          var note = [];
          Object.keys(scarti).map(Number).sort(function(a,b){ return a-b; }).forEach(function(d){
            note.push('<span class="sym">' + stelle(d) + '</span>'
                    + parola(d) + ' partit' + (d === 1 ? 'a' : 'e') + ' in meno');
          });
          if (penalizzate.length) {
            var testo = penalizzate.map(function(p){
              return p.nome + ': ' + p.pt + ' punt' + (p.pt === 1 ? 'o' : 'i') + ' di penalizzazione';
            }).join(' · ');
            note.push('<span class="sym">°</span>' + testo);
          }
          if (note.length) {
            h += '<div class="c-note">' + note.join('<br>') + '</div>';
          }

          h += '<div class="c-legenda">'
            +  '<span><i class="dot-promo"></i>Promozione diretta</span>'
            +  '<span><i class="dot-playoff"></i>Play-off</span>'
            +  '<span><i class="dot-playout"></i>Play-out</span>'
            +  '<span><i class="dot-retro"></i>Retrocessione</span></div>';

          target.innerHTML = h;
        })
        .catch(function(e){
          console.error('Classifica:', e);
          target.innerHTML = '<div style="text-align:center;padding:20px;color:#999;">Dati non disponibili al momento.</div>';
        });
    })();
    </script>
    <?php
    return ob_get_clean();
}
