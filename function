        window.removeEventListener('scroll', controlla);
        box.hidden = false;
        // doppio rAF: il browser deve registrare lo stato iniziale prima di animare
        requestAnimationFrame(function(){
          requestAnimationFrame(function(){ box.classList.add('rnp-on'); });
        });
      }

      function controlla() {
        var h = document.documentElement.scrollHeight - window.innerHeight;
        if (h <= 0) return;
        if ((window.scrollY || window.pageYOffset) / h >= SOGLIA) mostra();
      }

      document.getElementById('rnp-x').addEventListener('click', chiudi);
      document.getElementById('rnp-no').addEventListener('click', chiudi);
      document.getElementById('rnp-go').addEventListener('click', iscritto);

      if (MODO === 'timer') {
        setTimeout(mostra, ATTESA);
      } else {
        window.addEventListener('scroll', controlla, { passive: true });
      }
    })();
    </script>
    <?php
}
