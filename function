    </style>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const container = document.getElementById('rn-cal-container');
        const loading = document.getElementById('rn-loading');
        if (!container) return;

        const LOGHI = <?php echo $loghi_json; ?>;
       const JSON_URL = '<?php echo rest_url('rn/v1/data/calendario'); ?>?t=' + Date.now();

        const mesi = { 'gennaio':0,'febbraio':1,'marzo':2,'aprile':3,'maggio':4,'giugno':5,'luglio':6,'agosto':7,'settembre':8,'ottobre':9,'novembre':10,'dicembre':11 };
        const mesiBrevi = ['gen','feb','mar','apr','mag','giu','lug','ago','set','ott','nov','dic'];

        function logoUrl(name) {
            return LOGHI[name] || '';
        }

        function logoImg(name) {
            const url = logoUrl(name);
            return url ? `<img src="${url}" alt="${name}" onerror="this.style.display='none'">` : '';
        }

        function shortName(name) {
            // Le chiavi sono in minuscolo: il confronto ignora maiuscole/minuscole,
            // perché il nome nei dati puo' arrivare scritto in modi diversi
            // (es. "CastrumFavara" invece di "Castrumfavara").
            const abbr = {
    'castrumfavara': 'Castrum<wbr>Favara',
    'praiatortora': 'Praia<wbr>Tortora',
    'vigor lamezia': 'V. Lamezia',
    'athletic palermo': 'Ath. Palermo',
    'nuova igea virtus': 'N. Igea Virtus',
    'sancataldese': 'Sancataldese',
};
            const chiave = String(name || '').toLowerCase().trim();
            return abbr[chiave] || name;
        }

        function parseData(str) {
            const p = str.toLowerCase().trim().split(' ');
            if (p.length >= 4) {
                const g = parseInt(p[1]), m = mesi[p[2]], a = parseInt(p[3]);
                if (!isNaN(g) && m !== undefined && !isNaN(a)) return new Date(a, m, g);
            }
            return null;
        }

        fetch(JSON_URL)
            .then(r => r.json())
            .then(rows => {
                let html = '';
                let currentSection = '';

                rows.forEach(row => {
                    const dataStr    = row['data'] || '';
                    const orario     = row['orario'] || '';
                    const avversario = row['avversario'] || '';
                    const comp       = row['competizione'] || '';
                    const turno      = row['turno'] || '';
                    const ha         = row['H/A'] || '';
                    const gf         = row['GF'] || '';
                    const gs         = row['GS'] || '';
                    const vsp        = row['V/S/P'] || '';

                    if (!avversario || avversario.length < 2) return;

                    const dataPartita = parseData(dataStr);
                    // Il punteggio compare quando c'e', a prescindere dalla data:
                    // cosi' si vedono anche i risultati inseriti in anticipo.
                    const hasResult = gf !== '' && gs !== '';
                    const isHome = ha.toLowerCase().includes('casa');

                    const sectionLabel = comp.charAt(0).toUpperCase() + comp.slice(1);
                    if (sectionLabel !== currentSection) {
                        if (currentSection !== '') html += '</div>';
                        html += `<div class="rn-cal-section"><div class="rn-cal-section-title">${sectionLabel}</div>`;
                        currentSection = sectionLabel;
                    }

                    const homeName = isHome ? 'Reggina' : avversario;
                    const awayName = isHome ? avversario : 'Reggina';
                    const homeClass = isHome ? 'rn-cal-team reggina' : 'rn-cal-team';
                    const awayClass = isHome ? 'rn-cal-team away' : 'rn-cal-team away reggina';

                    let score = '— \u2013 —';
                    let badge = '';
                    if (hasResult) {
                        const gh = isHome ? gf : gs;
                        const ga = isHome ? gs : gf;
                        score = `${gh} \u2013 ${ga}`;
                        if (vsp.toUpperCase() === 'V') badge = '<span class="rn-cal-result rn-v">V</span>';
                        else if (vsp.toUpperCase() === 'S') badge = '<span class="rn-cal-result rn-s">S</span>';
                        else if (vsp.toUpperCase() === 'P') badge = '<span class="rn-cal-result rn-p">P</span>';
                    }

                    const dataCourta = dataPartita
                        ? dataPartita.getDate() + ' ' + mesiBrevi[dataPartita.getMonth()] + ' \u2014 ' + orario
                        : dataStr;

                    const turnoLabel = (comp.toLowerCase().includes('coppa') || !turno) ? '' : turno + 'a giornata';

                    html += `
                    <div class="rn-cal-row">
                        <div class="${homeClass}">${logoImg(homeName)}  <span>${shortName(homeName)}</span></div>
                        <div class="rn-cal-center-block">
                            ${turnoLabel ? `<div class="rn-cal-giornata">${turnoLabel}</div>` : ''}
                            <div class="rn-cal-score">${score}${badge}</div>
                            <div class="rn-cal-time">${dataCourta}</div>
                        </div>
                        <div class="${awayClass}">${logoImg(awayName)}<span>${shortName(awayName)}</span></div>
                    </div>`;
                });

                if (currentSection !== '') html += '</div>';
                if (loading) loading.style.display = 'none';
                container.innerHTML = html;
            })
            .catch(() => {
                if (loading) loading.style.display = 'none';
                container.innerHTML = '<p style="color:#bbb;font-size:0.8rem;">Errore nel caricamento.</p>';
            });
    });
    </script>
    <?php
}
