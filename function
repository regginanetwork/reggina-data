    <script>
    (function(){
      const BASE = '<?php echo RN_GITHUB_BASE; ?>';
      const RL={portiere:'Portiere',difensore:'Difensore',centrocampista:'Centrocampista',attaccante:'Attaccante'};
      const RC={portiere:'rnd-rp',difensore:'rnd-rd',centrocampista:'rnd-rc',attaccante:'rnd-ra'};
      const RO=['portiere','difensore','centrocampista','attaccante'];
      const COMP_LABEL={campionato:'campionato','coppa italia':'Coppa Italia'};

      let rosaData=[], calData=[], detData=[];
      let selezionate=new Set(['campionato']);
      let currentView='g';
      let allP=[], matches=[], fasce=[], curF='tutti', curS='', minDone=false, pagDone=false, squadraDone=false;

      const fmt=n=>String(n).replace(/\B(?=(\d{3})+(?!\d))/g,'.');
      const num=v=>{const n=parseInt(v);return isNaN(n)?0:n;};
      const dec=v=>{const n=parseFloat(String(v||'').replace(',','.'));return isNaN(n)?null:n;};
      const spett=v=>{const s=String(v||'').replace(/[^0-9]/g,'');return s?parseInt(s):null;};

      /* Campionato: g1, g2, g3... Coppa Italia: sempre "CI", senza numero. */
      function labelPartita(comp,num,prefisso){
        return comp==='coppa italia' ? 'CI' : (prefisso+num);
      }

      /* Le date arrivano come "domenica 30 agosto 2026": servono per ordinare
         cronologicamente le partite di competizioni diverse, dato che il numero
         di turno non e' confrontabile fra campionato (numerico) e Coppa Italia
         (testuale, es. "I turno"). */
      const MESI_IT={gennaio:0,febbraio:1,marzo:2,aprile:3,maggio:4,giugno:5,luglio:6,agosto:7,settembre:8,ottobre:9,novembre:10,dicembre:11};
      function parseDataIt(str){
        const parti=String(str||'').toLowerCase().trim().split(/\s+/);
        if(parti.length<4)return null;
        const giorno=parseInt(parti[1]), mese=MESI_IT[parti[2]], anno=parseInt(parti[3]);
        if(isNaN(giorno)||mese===undefined||isNaN(anno))return null;
        return new Date(anno,mese,giorno);
      }

      const t=Date.now();
      Promise.all([
        fetch(BASE+'rosa-anagrafica.json?t='+t).then(r=>r.json()),
        fetch(BASE+'calendario.json?t='+t).then(r=>r.json()),
        fetch(BASE+'minuti-gol.json?t='+t).then(r=>r.json()),
      ]).then(([rosa,cal,det])=>{
        rosaData=rosa; calData=cal; detData=det;
        ricalcola();
      }).catch(e=>{
        document.getElementById('rnd-grid').innerHTML='<div class="rnd-loading">Errore nel caricamento dei dati.</div>';
        console.error('DatAmaranto:',e);
      });

      /* ---------- RICALCOLO IN BASE ALLE COMPETIZIONI SELEZIONATE ---------- */
      function ricalcola(){
        /* ---------- 1. ANAGRAFICA ----------
           Il cognome da solo non basta: in rosa possono esserci due omonimi
           (es. due Girasole). La chiave e' cognome + numero di maglia. */
        const P={}, perCognome={};
        const chiave=(cog,maglia)=>cog.toLowerCase()+'#'+String(maglia||'').trim();

        rosaData.forEach(r=>{
          const v=(r['in rosa']||'').toLowerCase();
          if(v!=='sì'&&v!=='si')return;
          const cog=(r['cognome']||'').trim(); if(!cog)return;
          const mag=String(r['numero maglia']||'').trim();
          const k=chiave(cog,mag);
          (perCognome[cog.toLowerCase()]=perCognome[cog.toLowerCase()]||[]).push(k);
          P[k]={cognome:cog,nome:(r['nome']||'').trim(),maglia:r['numero maglia']||'',
            ruolo:(r['ruolo']||'').toLowerCase(),underover:r['under/over']||'',
            nascita:r['data di nascita']||'',eta:r['età']||'',
            contratto:r['tipologia contratto']||'',scadenza:r['scadenza contratto']||'',
            transfermarkt:r['transfermarkt']||'',
            presenze:0,titolare:0,subentrato:0,minuti:0,gol:0,assist:0,
            amm:0,esp:0,golSub:0,cs:0,giornate:{},mediaVoto:null};
        });

        /* ---------- 2. PARTITE (calendario), filtrate per competizione selezionata
           e ordinate per data reale — non per turno, che non e' confrontabile fra
           campionato (numerico) e Coppa Italia (testuale, es. "I turno"). ---------- */
        matches=calData
          .filter(r=>selezionate.has((r['competizione']||'').toLowerCase().trim()))
          .filter(r=>(r['V/S/P']||'')!=='')
          .map(r=>{
            const comp=(r['competizione']||'').toLowerCase().trim();
            const turno=String(r['turno']||'').trim();
            return Object.assign({}, r, {
              _comp:comp,
              _key:comp+'|'+turno.toLowerCase(),
              _data:parseDataIt(r['data'])
            });
          })
          .sort((a,b)=>{
            const da=a._data?a._data.getTime():0, db=b._data?b._data.getTime():0;
            return da-db;
          });
        matches.forEach((m,i)=>{ m._idx=i+1; });

        // Numerazione g1,g2... solo fra le partite di campionato: la Coppa
        // Italia viene sempre segnalata semplicemente come "CI", senza numero.
        let contCampionato=0;
        matches.forEach(m=>{
          if(m._comp==='campionato'){ contCampionato++; m._numCampionato=contCampionato; }
        });

        Object.values(P).forEach(p=>{
          matches.forEach(m=>{ p.giornate[m._key]={min:0,voto:null,idx:m._idx,comp:m._comp,num:m._numCampionato}; });
        });

        /* ---------- 3. DETTAGLIO MATCH ---------- */
        fasce=[
          {label:"0–25'",min:0,max:25,fatti:0,subiti:0},
          {label:"26–45'",min:26,max:45,fatti:0,subiti:0},
          {label:"46–65'",min:46,max:65,fatti:0,subiti:0},
          {label:"66–85'",min:66,max:85,fatti:0,subiti:0},
          {label:"86'+",min:86,max:200,fatti:0,subiti:0},
        ];

        /* Il numero di maglia nel foglio DettaglioMatch rende esatto l'abbinamento
           anche con gli omonimi. L'intestazione della colonna puo' essere scritta
           in modi diversi, quindi cerchiamo la prima chiave che contiene "maglia".
           Senza numero si puo' abbinare solo quando il cognome e' unico in rosa. */
        const omonimi={};
        function magliaDi(r){
          const k=Object.keys(r).find(x=>x.toLowerCase().indexOf('maglia')>-1);
          return k?String(r[k]||'').trim():'';
        }
        function trovaGiocatore(cog,mag){
          const lista=perCognome[cog.toLowerCase()];
          if(!lista||!lista.length)return null;
          if(mag&&P[chiave(cog,mag)])return P[chiave(cog,mag)];
          if(lista.length===1)return P[lista[0]];
          omonimi[cog]=1;
          return null;
        }

        detData
          .filter(r=>selezionate.has((r['competizione']||'').toLowerCase().trim()))
          .forEach(r=>{
            const cog=(r['nome']||'').trim();
            const magDet=magliaDi(r);
            const comp=(r['competizione']||'').toLowerCase().trim();
            const turno=String(r['turno']||'').trim();
            const key=comp+'|'+turno.toLowerCase();
            const minuti=num(r['minuti giocati']);
            const golRaw=String(r['gol']||'').trim();

            /* Il ruolo nel foglio DettaglioMatch puo' essere scritto in modi diversi
               (POR, Portiere, P...). Quando il giocatore e' in rosa usiamo il ruolo
               dell'anagrafica, che e' l'unico su cui possiamo contare. */
            const p=trovaGiocatore(cog,magDet);
            const ruoloDet=(r['ruolo']||'').toLowerCase().trim();
            const isPortiere = p
              ? p.ruolo==='portiere'
              : (ruoloDet==='portiere'||ruoloDet==='por'||ruoloDet==='p');

            const minGol=String(r['min. gol']||'');
            if(minGol){
              minGol.split(';').map(m=>parseInt(String(m).trim().replace(/\+\d+/,'')))
                .filter(m=>!isNaN(m)&&m>0).forEach(m=>{
                  fasce.forEach(f=>{if(m>=f.min&&m<=f.max){isPortiere?f.subiti++:f.fatti++;}});
                });
            }

            if(!p)return;

            if(num(r['titolare']))p.titolare++;
            if(num(r['subentrato']))p.subentrato++;
            if(minuti>0)p.presenze++;
            p.minuti+=minuti;
            if(num(r['ammonizione']))p.amm++;
            if(num(r['espulsione']))p.esp++;
            p.assist+=num(r['assist']);

            if(isPortiere){
              if(golRaw.toUpperCase()==='CS')p.cs++;
              else p.golSub+=num(golRaw);
            } else {
              p.gol+=num(golRaw);
            }

            if(p.giornate[key]!==undefined){
              const prec=p.giornate[key];
              p.giornate[key]={min:minuti,voto:dec(r['voto']),idx:prec.idx,comp:prec.comp,num:prec.num};
            }
          });

        Object.values(P).forEach(p=>{
          const e=Object.values(p.giornate).filter(g=>g.voto!==null&&g.min>0);
          if(e.length){
            const sv=e.reduce((s,g)=>s+g.voto*g.min,0), sm=e.reduce((s,g)=>s+g.min,0);
            p.mediaVoto=sm>0?sv/sm:null;
          }
        });

        allP=Object.values(P);
        allP.forEach((p,i)=>{p.id=i;});
        Object.keys(omonimi).forEach(cog=>{
          console.warn('DatAmaranto: "'+cog+'" e\' presente in rosa piu\' di una volta. '+
            'Aggiungi la colonna "numero maglia" nel foglio DettaglioMatch per attribuire i dati.');
        });

        if(!matches.length){
          const listaComp=Array.from(selezionate).map(c=>COMP_LABEL[c]||c).join(' e ');
          document.getElementById('rnd-notice').innerHTML=
            '<div class="rnd-notice"><div class="rnd-notice-t">Nessuna partita disputata</div>'+
            '<div class="rnd-notice-b">La rosa è già consultabile, ma le statistiche per '+listaComp+
            ' compariranno qui dopo la prima partita giocata. Da quel momento la dashboard si aggiornerà '+
            'automaticamente dopo ogni partita.</div></div>';
        } else {
          document.getElementById('rnd-notice').innerHTML='';
        }

        renderGrid();
        // Se la scheda di un giocatore è aperta, la aggiorniamo con i nuovi
        // dati senza chiuderla: altrimenti il filtro sembrava non avere effetto.
        if(openPlayerId!==null && allP[openPlayerId]){
          document.getElementById('rnd-dw').innerHTML=buildDettaglioHtml(allP[openPlayerId]);
        }
        minDone=false; pagDone=false; squadraDone=false;
        if(currentView==='min'){minDone=true; renderMin();}
        if(currentView==='pag'){pagDone=true; renderPag();}
        if(currentView==='s'){squadraDone=true; renderSquadra();}
      }

      /* ---------- GRIGLIA GIOCATORI ---------- */
      function renderGrid(){
        const s=[...allP].sort((a,b)=>{
          const d=RO.indexOf(a.ruolo)-RO.indexOf(b.ruolo);
          return d!==0?d:(parseInt(a.maglia)||99)-(parseInt(b.maglia)||99);});
        document.getElementById('rnd-grid').innerHTML=s.map(p=>{
          const ip=p.ruolo==='portiere';
          const s2=ip?{v:p.golSub,l:'Gol sub',c:'r'}:{v:p.gol,l:'Gol',c:p.gol>0?'r':''};
          const s3=ip?{v:p.cs,l:'Clean sh.',c:'g'}:{v:p.assist,l:'Assist',c:''};
          return '<div class="rnd-pcard" onclick="rndOpen('+p.id+')" data-ruolo="'+p.ruolo+'" data-nome="'+(p.cognome+' '+p.nome).toLowerCase()+'">'+
            '<div class="rnd-pcard-header"><div class="rnd-pcard-num">'+(p.maglia||'—')+'</div><div class="rnd-pcard-sep"></div>'+
            '<div class="rnd-pcard-names"><div class="rnd-pcard-fn">'+p.nome+'</div><div class="rnd-pcard-sn">'+p.cognome+'</div>'+
            '<span class="rnd-rb '+(RC[p.ruolo]||'rnd-rd')+'">'+(RL[p.ruolo]||p.ruolo)+'</span></div></div>'+
            '<div class="rnd-pcard-stats">'+
            '<div class="rnd-ps"><span class="rnd-psv">'+fmt(p.presenze)+'</span><span class="rnd-psl">Presenze</span></div>'+
            '<div class="rnd-ps"><span class="rnd-psv '+s2.c+'">'+fmt(s2.v)+'</span><span class="rnd-psl">'+s2.l+'</span></div>'+
            '<div class="rnd-ps"><span class="rnd-psv '+s3.c+'">'+fmt(s3.v)+'</span><span class="rnd-psl">'+s3.l+'</span></div></div>'+
            '<div class="rnd-pcard-footer">scheda completa <span class="rnd-farrow">→</span></div></div>';
        }).join('');
      }

      /* ---------- SCHEDA GIOCATORE ---------- */
      let openPlayerId=null;

      function buildDettaglioHtml(p){
        const ip=p.ruolo==='portiere';
        const gi=Object.entries(p.giornate).sort((a,b)=>a[1].idx-b[1].idx);

        const minBars=gi.map(function(e){const g=e[1], lbl=labelPartita(g.comp,g.num,'G');
          if(g.min===0)return '<div class="rnd-bar"><div class="rnd-bar-m">&nbsp;</div><div class="rnd-bar-fill rnd-bar-empty" style="height:4px"></div><div class="rnd-bar-g">'+lbl+'</div></div>';
          const h=Math.max(4,Math.round((g.min/90)*70));
          const c=g.min>=80?'#1a7a3a':g.min>=50?'#5cb85c':g.min>=20?'#a5d6a7':'#e0e0e0';
          return '<div class="rnd-bar"><div class="rnd-bar-m">'+g.min+"'"+'</div><div class="rnd-bar-fill" style="height:'+h+'px;background:'+c+'"></div><div class="rnd-bar-g">'+lbl+'</div></div>';
        }).join('');

        const votoBars=gi.map(function(e){const g=e[1], lbl=labelPartita(g.comp,g.num,'G');
          if(g.voto===null)return '<div class="rnd-bar"><div class="rnd-bar-v">&nbsp;</div><div class="rnd-bar-fill rnd-bar-empty" style="height:4px"></div><div class="rnd-bar-g">'+lbl+'</div></div>';
          const h=Math.max(4,(g.voto-3)*24);
          const c=g.voto>=6.5?'#1a7a3a':g.voto>=6?'#5cb85c':g.voto>=5.5?'#FFD54F':'#e57373';
          return '<div class="rnd-bar"><div class="rnd-bar-v">'+g.voto.toFixed(1).replace('.',',')+'</div><div class="rnd-bar-fill" style="height:'+h+'px;background:'+c+'"></div><div class="rnd-bar-g">'+lbl+'</div></div>';
        }).join('');

        const mv=p.mediaVoto;
        const kpis=ip
          ?[{v:fmt(p.presenze),l:'Presenze',c:''},{v:fmt(p.minuti)+"'",l:'Minuti',c:''},{v:fmt(p.golSub),l:'Gol subiti',c:'r'},{v:fmt(p.cs),l:'Clean sheet',c:'g'}]
          :[{v:fmt(p.presenze),l:'Presenze',c:''},{v:fmt(p.minuti)+"'",l:'Minuti',c:''},{v:fmt(p.gol),l:'Gol',c:p.gol>0?'r':''},{v:fmt(p.assist),l:'Assist',c:''}];
        kpis.push({v:mv!==null?mv.toFixed(2).replace('.',','):'—',l:'Media voto',c:mv===null?'':mv>=6.5?'g':mv>=6?'':'r',span:true});

        const isU=(p.underover||'').toLowerCase().indexOf('under')>-1;
        const anag=[p.nascita?'nato il '+p.nascita:'',p.contratto||'',p.scadenza?'scadenza '+p.scadenza:''].filter(Boolean).join(' · ');

